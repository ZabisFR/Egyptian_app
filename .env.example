# Variables nécessaires à l'application (à configurer aussi sur Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Utilisée UNIQUEMENT par les scripts locaux (import, generate:quiz).
# Ne pas la configurer sur Vercel : l'application n'en a pas besoin, et l'y mettre
# exposerait inutilement une clé qui contourne toutes les policies RLS.
SUPABASE_SECRET_KEY=sb_secret_...

# Tuteur IA (Google Gemini). Clé à créer sur https://aistudio.google.com/apikey.
# Côté serveur uniquement : surtout PAS de préfixe NEXT_PUBLIC_, qui l'enverrait au navigateur.
GOOGLE_GENERATIVE_AI_API_KEY=
# Facultatif : modèle Gemini utilisé. Par défaut : gemini-flash-latest (voir lib/chat-config.ts).
CHAT_MODEL=

# Prononciation du vocabulaire (npm run generate:audio), Azure Speech.
# UNIQUEMENT pour le script local : les sons sont ensuite des fichiers statiques, le site
# n'appelle jamais Azure. Ne pas configurer sur Vercel.
# Clé et région : portail Azure → ressource « Speech » → « Keys and Endpoint ».
AZURE_SPEECH_KEY=
# Région = celle choisie à la création de la ressource, en minuscules sans espace
# (francecentral, swedencentral…). West Europe refuse parfois les nouveaux clients.
AZURE_SPEECH_REGION=francecentral
# Facultatif : ar-EG-ShakirNeural (par défaut, voix d'homme, retenue à l'écoute) ou
# ar-EG-SalmaNeural (femme). Changer de voix fait régénérer tous les sons.
AZURE_SPEECH_VOICE=
